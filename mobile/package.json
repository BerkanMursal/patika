    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "maplibre-gl": "^6.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "~19.2.2",
    "@types/supercluster": "^7.1.3",
    "esbuild": "^0.28.2",
    "osmtogeojson": "3.0.0-beta.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:map": "node scripts/build-map.cjs",
    "prestart": "npm run build:map",
    "preweb": "npm run build:map",
    "preexport:web": "npm run build:map",
    "preexport:native": "npm run build:map",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web --max-workers 2 && node scripts/prepare-web.mjs",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native --max-workers 2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/patch-dependencies.cjs"
  },
  "private": true,
  "overrides": {
    "osmtogeojson": {
      "@xmldom/xmldom": "0.9.12"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "0.5.0"
  }
}
